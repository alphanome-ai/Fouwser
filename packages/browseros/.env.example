# Windows Code Signing
ESIGNER_USERNAME=
ESIGNER_PASSWORD=
# TOTP secret (QR code secret) for 2FA
ESIGNER_TOTP_SECRET=
ESIGNER_CREDENTIAL_ID=
CODE_SIGN_TOOL_PATH=C:/src/CodeSignTool-v1.3.2-windows

# macOS Code Signing
MACOS_CERTIFICATE_NAME=
PROD_MACOS_NOTARIZATION_APPLE_ID=
PROD_MACOS_NOTARIZATION_TEAM_ID=
PROD_MACOS_NOTARIZATION_PWD=

# Object storage backend: "r2" (default) or "azure"
STORAGE_BACKEND=azure

# Cloudflare R2 (used when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=fouwser
# Public CDN host baked into artifact + appcast URLs (use https in production).
# For Azure this is your Azure CDN / Front Door custom domain.
R2_CDN_BASE_URL=http://cdn.fouwser.com

# Azure Blob Storage (used when STORAGE_BACKEND=azure)
AZURE_STORAGE_CONNECTION_STRING=
# Container name; defaults to R2_BUCKET if unset
AZURE_STORAGE_CONTAINER=fouwser

# Slack Notifications
SLACK_WEBHOOK_URL=

# Sparkle Signing (macOS only)
SPARKLE_PRIVATE_KEY=
SUPublicEDKey=
# Path to sign_update tool
SPARKLE_SIGN_UPDATE_PATH=


# CHROMIUM_SRC=C:/src/chromium/src
# DEPOT_TOOLS_WIN_TOOLCHAIN=0
# CHROME_PACKER=
